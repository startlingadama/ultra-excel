# Leave unset for local dev - vite.config.ts proxies /api to
# http://localhost:8080 automatically.
# In production, set this to your deployed Go gateway's origin:
# VITE_API_URL=https://api.ultra-excel.example.com

# --- Keycloak (Authorization Code + PKCE) ---
# Defaults below match infra/docker-compose.yml + infra/keycloak/realm-export.json
# for local dev; override for a different Keycloak instance/realm/client.
# VITE_OIDC_AUTHORITY=http://localhost:8081/realms/ultra-excel
# VITE_OIDC_CLIENT_ID=ultra-excel-front
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/
