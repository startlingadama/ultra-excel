# Copy to .env and fill in real values before running `docker compose up`.
# Never commit the resulting .env file.

# --- Postgres (Keycloak's database) ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Keycloak bootstrap admin (console at http://localhost:8081) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-to-a-strong-password
